        DOMINATED;
        EMPOWERED;
        ENFEEBLED;
        ENAMORED;
        ENERGIZED;
        ENRAGED;
        ENTANGLED;
        ENTHRALLED;
        EXHAUSTED;
        FRIGHTENED;
        FROZEN;
        GUARDED;
        GUARDING;
        HASTENED;
        IMMOBILIZED;
        INCAPACITATED;
        INTIMIDATED;
        INVIGORATED;
        INVISIBLE;
        MEDITATING;
        MARKED;
        NERVOUS;
        PANICKED;
        PACIFIED;
        PARALYZED;
        PETRIFIED;
        PHASED;
        POISONED;
